{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "geofence-labeler",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8765", "--directory", "geofence"],
      "port": 8765
    },
    {
      "name": "website",
      "runtimeExecutable": "firebase",
      "runtimeArgs": [
        "emulators:exec",
        "--only",
        "auth,functions,firestore",
        "npx tsx seed.ts && npm --prefix website run dev"
      ],
      "port": 5173,
      "autoPort": false,
      "url": "http://localhost:5173"
    }
  ]
}
